      "key": "buyer_phone",
      "value": "+94771234567",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "ORD-2026-9876",
      "type": "string"
    },
    {
      "key": "expected_amount",
      "value": "5000.00",
