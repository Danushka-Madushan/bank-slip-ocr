              "body": "{\n  \"status\": \"ok\",\n  \"receipt_id\": \"a1b2c3d4e5f67890123456789abcdef0\",\n  \"verdict\": \"approved\"\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
