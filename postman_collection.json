    {
      "name": "2. Receipt Verification & Forensics",
      "description": "Multi-stage receipt verification endpoints doing image analysis, OCR, ELA forensics, and duplicate detection.",
      "item": [
        {
          "name": "Verify Receipt (Full Analysis & Register)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "description": "Receipt image file (.jpg, .jpeg, .png, .webp). Click 'Select File' to choose your image.",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "order_id",
                  "value": "{{order_id}}",
                  "description": "Order or invoice identifier.",
                  "type": "text"
                },
                {
                  "key": "expected_amount",
                  "value": "{{expected_amount}}",
                  "description": "Expected transaction amount in LKR.",
                  "type": "text"
                },
                {
                  "key": "expected_account",
                  "value": "{{expected_account}}",
                  "description": "Expected merchant receiving bank account number.",
                  "type": "text"
                },
                {
                  "key": "buyer_phone",
                  "value": "{{buyer_phone}}",
                  "description": "Buyer phone number (+94xxxxxxxxx) to check global trust score.",
                  "type": "text"
                },
                {
                  "key": "register",
                  "value": "true",
                  "description": "Set to true to persist record to SQLite for future duplicate detection.",
                  "type": "text"
                },
                {
                  "key": "include_raw_text",
                  "value": "false",
                  "description": "Set to true if full OCR bounding text is needed (off by default to protect PII).",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/verify-receipt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify-receipt"
              ]
            },
            "description": "Uploads and verifies a bank payment slip against forensic heuristics, OCR, merchant expectations, and historical duplicate records."
          },
          "response": [
            {
              "name": "200 OK - Verified Commercial Bank Slip",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/verify-receipt",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "verify-receipt"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"receipt_id\": \"a1b2c3d4e5f67890123456789abcdef0\",\n  \"registered\": true,\n  \"risk\": {\n    \"score\": 4.5,\n    \"level\": \"low\",\n    \"recommendation\": \"accept\"\n  },\n  \"signals\": [\n    {\n      \"code\": \"clean_receipt\",\n      \"weight\": 0.0,\n      \"detail\": \"All key fields present with high OCR confidence.\"\n    }\n  ],\n  \"bank\": {\n    \"name\": \"Commercial Bank\",\n    \"confidence\": 0.95,\n    \"candidates\": {\n      \"Commercial Bank\": 6,\n      \"Sampath Bank\": 0\n    }\n  },\n  \"fields\": {\n    \"amount\": {\n      \"value\": \"5000.00\",\n      \"raw\": \"LKR 5,000.00\",\n      \"confidence\": 0.98\n    },\n    \"reference\": {\n      \"value\": \"COMB20261112999\",\n      \"raw\": \"Ref: COMB20261112999\",\n      \"confidence\": 0.95\n    },\n    \"datetime\": {\n      \"value\": \"2026-11-12T14:30\",\n      \"raw\": \"12/11/2026 14:30:15\",\n      \"confidence\": 0.92\n    },\n    \"beneficiary_account\": {\n      \"value\": \"1234567890\",\n      \"raw\": \"1234567890\",\n      \"confidence\": 0.96\n    },\n    \"status\": \"success\"\n  },\n  \"buyer_trust\": {\n    \"buyer_phone\": \"+94771234567\",\n    \"trust_score\": 95,\n    \"total_receipts\": 4,\n    \"fraud_count\": 0,\n    \"low_trust_warning\": false\n  },\n  \"hashes\": {\n    \"sha256\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n    \"phash\": \"d4e2a1b9c7f08831\"\n  },\n  \"forensics\": {\n    \"metadata\": {\n      \"format\": \"JPEG\",\n      \"width\": 1080,\n      \"height\": 1920,\n      \"editor_markers\": []\n    },\n    \"ela\": {\n      \"computed\": true,\n      \"reliable_source\": true,\n      \"mean\": 12.4,\n      \"numeric_text_outliers\": []\n    }\n  },\n  \"ocr\": {\n    \"line_count\": 24,\n    \"mean_confidence\": 0.94,\n    \"low_confidence_count\": 0\n  },\n  \"processing_ms\": 1180\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Response contains valid receipt verification fields', function () {",
                  "    pm.expect(jsonData).to.have.property('receipt_id');",
                  "    pm.expect(jsonData).to.have.property('risk');",
                  "    pm.expect(jsonData).to.have.property('bank');",
                  "    pm.expect(jsonData).to.have.property('fields');",
                  "    pm.expect(jsonData).to.have.property('hashes');",
                  "    pm.expect(jsonData).to.have.property('forensics');",
                  "});",
                  "if (jsonData.receipt_id) {",
                  "    pm.collectionVariables.set('receipt_id', jsonData.receipt_id);",
                  "    pm.environment.set('receipt_id', jsonData.receipt_id);",
                  "    console.log('Saved receipt_id to variable: ' + jsonData.receipt_id);",
                  "}"
                ]
              }
            }
          ]
        },
