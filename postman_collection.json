        {
          "name": "Verify Receipt (Full OCR Debug Mode)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "include_raw_text",
                  "value": "true",
                  "description": "Enables detailed OCR text lines and low confidence token debugging.",
                  "type": "text"
                },
                {
                  "key": "register",
                  "value": "false",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/verify-receipt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify-receipt"
              ]
            },
            "description": "Enables raw OCR text output (`include_raw_text=true`) to inspect all parsed lines and low-confidence tokens."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Raw text lines are included', function () {",
                  "    pm.expect(jsonData.ocr).to.have.property('text_lines');",
                  "    pm.expect(jsonData.ocr.text_lines).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Merchant Verdicts & Workflows",
      "description": "Endpoints allowing merchants to approve or reject receipts and mark fraud.",
      "item": [
        {
          "name": "Record Merchant Verdict (Approve)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "verdict",
                  "value": "approved",
                  "description": "Verdict string: approved | rejected_fraud",
                  "type": "text"
                },
                {
                  "key": "buyer_phone",
                  "value": "{{buyer_phone}}",
                  "description": "Buyer phone number associated with the order.",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/receipts/{{receipt_id}}/verdict",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "receipts",
                "{{receipt_id}}",
                "verdict"
              ]
