{
  "info": {
    "_postman_id": "fda2bf90-9b66-4511-8dc4-5f8dd2b6362f",
    "name": "eMerchantLK Bank Receipt Verification Engine API",
    "description": "Comprehensive Postman test collection for the eMerchantLK Receipt Verification Engine (v2.1.0).\n\nFeatures:\n- Automatic detection of Sri Lankan Banks (BOC, Commercial Bank, FriMi/NTB, Sampath, HNB, People's Bank, etc.)\n- Perceptual Hashing (pHash) and SHA-256 duplicate detection\n- Error Level Analysis (ELA) and image forensics\n- OCR text and field extraction (Amount, Reference, Timestamp, Beneficiary Account)\n- Merchant 1-tap verdict workflow (Approved / Rejected Fraud)\n- Global Buyer Trust Score calculation and fraud guard",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.1.0"
  },
